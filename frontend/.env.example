# Supabase Configuration
# The URL of your Supabase project (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# The public anonymous key for your Supabase project (found in Project Settings > API)
# This key is safe to expose in client-side code as it only grants access
# controlled by Row Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
