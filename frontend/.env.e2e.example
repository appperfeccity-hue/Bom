# E2E Test Environment Configuration
# Copy this file to .env.e2e and fill in real values.
# NEVER commit .env.e2e with real credentials.

# Application URL
PLAYWRIGHT_BASE_URL=https://bom-beryl.vercel.app

# Supabase connection (anon key only - NEVER use service-role key here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Test user credentials (must exist in the Supabase Auth database)
E2E_DESIGNER_EMAIL=designer@perfeccity.test
E2E_DESIGNER_PASSWORD=your-designer-password
E2E_CONSULTANT_EMAIL=consultant@perfeccity.test
E2E_CONSULTANT_PASSWORD=your-consultant-password
E2E_ADMIN_EMAIL=admin@perfeccity.test
E2E_ADMIN_PASSWORD=your-admin-password
